# ── 知行公考 · 环境变量模板 ─────────────────────────────
# 复制为 server/.env 后按【生产】标注逐项替换；.env 已 gitignore，切勿提交。
# 真实密钥（DeepSeek 等）只写在服务器本地 .env，不进仓库。

# 数据库（默认 SQLite，生产可换 PostgreSQL）
# 【生产】文件名已去旧品牌，建议统一为 zhixing.db（换名需同时迁移旧库文件）
DATABASE_URL=sqlite:///./data/zhixing.db

# JWT 签名密钥 —— 【生产必填】生成：openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS —— 仅浏览器跨域需要；微信小程序不校验 CORS。
# H5 与 API 同域部署时其实用不到，但请显式写成实际域名，不要用 *
# （* 会关闭凭据携带，见 config.py 的 cors_allow_credentials）。
# 【生产】改为 https://zhixinggk.ltd
CORS_ORIGINS=http://localhost:10087

# 注册开关 —— 【生产决策】true=开放自助注册；false=仅管理员开通账号。
# 提审阶段建议 false + 预先开好审核用体验账号，规避「纯账密且无找回」的拒审点；
# 若保持 true，需先补「忘记密码」路径。
ALLOW_REGISTER=true

DEFAULT_PRODUCT_KEY=general
ENABLED_PRODUCT_KEYS=general

# 知识框架（可选：本机 Obsidian 目录；留空则只用 data/knowledge + 管理端上传）
KNOWLEDGE_KB_DIR=

# 默认管理员 —— 【生产必填】
# 仅用于「admin_users 表为空时」的首次播种（app/seed.py:25）。
# ⚠️ 已部署过的服务器上只改这里**不会生效**，改密请走自助接口：
#      PUT /admin/auth/password   body: {"oldPassword": "...", "newPassword": "..."}
#    新密码要求 ≥8 位且同时含字母与数字；改完需重新登录（旧令牌在有效期内仍有效）。
#    备用手段：删掉该管理员行后重启重新播种，或用 bcrypt 哈希直接 UPDATE admin_users。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# AI 出题（DeepSeek OpenAI 兼容接口）
# ⚠️ 提审期保持 false：应用内出现 AI 生成内容会牵出生成式 AI 标识与备案要求
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=120

# 语音识别（默认 none=前端免费 Web Speech；需要更准时再开云）
# ASR_PROVIDER=none|aliyun|tencent
ASR_PROVIDER=none
# 云配置齐全后是否优先云识别（false=仍优先免费浏览器）
ASR_PREFER_CLOUD=false
ALIYUN_ASR_APPKEY=
ALIYUN_ASR_TOKEN=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_APP_ID=
