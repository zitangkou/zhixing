# 复制为 .env 后修改（deploy.sh 首次部署会自动生成并填写密钥与管理员密码）
SECRET_KEY=please-change-me-use-openssl-rand-hex-32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 时区（业务日期按此时区计算）
TZ=Asia/Shanghai

# SQLite 数据目录（容器内挂载卷）
DATABASE_URL=sqlite:///./data/zhixing.db

# CORS：同域部署可 *；多端跨域时写具体地址（逗号分隔）
CORS_ORIGINS=*

# 是否开放移动端自助注册（生产建议 false，由管理员开通账号）
ALLOW_REGISTER=false

# ---- 部署 ----
# 容器宿主监听地址与端口：
#   当前默认（独立服务器、备案前）：容器直接监听公网 80，可用公网 IP 联调 H5 与公众号回调
#   域名 HTTPS 上线后：改为 HTTP_BIND=127.0.0.1、HTTP_PORT=8081，
#                     由宿主机 Nginx 监听 80/443 并转发（deploy/nginx.conf）
HTTP_BIND=0.0.0.0
HTTP_PORT=80
# 对外域名（备案前留空；域名网关模式填写真实域名）
DOMAIN=

# ---- 杜衡阁公众号服务器回调（基础明文联调） ----
# 微信后台 URL：http://公网IP/api/wechat/callback（联调）或 https://域名/api/wechat/callback（正式）
# Token 至少 16 位随机字符；不要提交真实 Token / AppSecret / EncodingAESKey。
WECHAT_OFFICIAL_ENABLED=false
WECHAT_OFFICIAL_TOKEN=
WECHAT_OFFICIAL_APP_ID=
WECHAT_OFFICIAL_PUBLIC_BASE_URL=

# ---- 备份（deploy/backup.sh） ----
BACKUP_DIR=/opt/backups
BACKUP_RETENTION_DAYS=14

# ---- 知识框架（可选：本机 Obsidian 目录；生产留空则走 data/knowledge + 管理端上传） ----
KNOWLEDGE_KB_DIR=
